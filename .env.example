# Public frontend configuration only.
# Never put provider API keys or other secrets in VITE_* variables: Vite embeds
# VITE_* values into the browser bundle.

# Optional base URL for your server-side AI/API gateway.
VITE_API_BASE_URL="http://localhost:8787"

# Optional public application URL used for links in the UI.
VITE_APP_URL="http://localhost:3000"
